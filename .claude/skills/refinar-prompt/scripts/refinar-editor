#!/usr/bin/env bash
# refinar-editor: usado como $VISUAL pelo Claude Code (Ctrl+G na caixa de prompt).
#
# Refina o rascunho com a skill refinar-prompt inteira (SKILL.md, boas-praticas.md
# e exemplos.md) numa chamada separada do `claude -p` e devolve só o prompt
# refinado para a caixa, sem enviar. A sessão principal nunca vê o rascunho. A
# resposta completa (o que mudou, pontos em aberto, sugestões) fica em
# ~/.cache/refinar/ultimo.md.
#
# Qualquer outro arquivo (ex.: git commit) e um segundo Ctrl+G em cima de um
# texto recém-refinado abrem o editor normal.
#
# `refinar-editor --demo` mostra a animação sem chamar o modelo.
#
# Variáveis: REFINAR_MODELO (padrão: sonnet), REFINAR_EDITOR (padrão: $EDITOR ou nano).
set -uo pipefail

dir_skill="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/refinar"
modelo="${REFINAR_MODELO:-sonnet}"
separador="=====FIM-DO-PROMPT====="

abrir_normal() { exec ${REFINAR_EDITOR:-${EDITOR:-nano}} "$@"; }
aparar() { sed -e ':a' -e '/^\n*$/{$d;N;ba' -e '}' | sed -e '/./,$!d'; }

# ---------------------------------------------------------------- tela
# Desenha no /dev/tty, numa tela alternativa (como o vim), enquanto o modelo
# trabalha. Sem terminal (testes, pipes), as funções de tela não fazem nada.

tela=0
if ( : > /dev/tty ) 2> /dev/null; then exec 3> /dev/tty; tela=1; fi

E=$'\033'
LARGURA=48
GRADIENTE=(213 212 207 177 171 141 135 105 99 69 75 81 87 123 159)
BRILHO=(213 207 171 141 105 69 75 81 87 81 75 69 105 141 171 207)
# "REFINAR" em letras de bloco: 3 linhas por letra.
LOGO=("█▀█" "█▀▄" "▀ ▀"  "█▀▀" "█▀▀" "▀▀▀"  "█▀▀" "█▀ " "▀  "  "█" "█" "▀"
      "█▄ █" "█ ▀█" "▀  ▀"  "▄▀█" "█▀█" "▀ ▀"  "█▀█" "█▀▄" "▀ ▀")
RASTRO=(231 213 177 141 105 61)
SPINNER=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
FRASES=("lendo o rascunho" "separando as ideias" "organizando a ordem"
        "deixando claro para a IA" "conferindo se nada se perdeu" "polindo o texto" "quase lá")

put() { (( tela )) && printf '%s' "$*" >&3; return 0; }
cor() { printf '%s[38;5;%sm' "$E" "$1"; }
em() { printf '%s[%s;%sH' "$E" "$(( y + $1 ))" "$(( x + $2 ))"; }
linha_nova() { printf '%s[%s;%sH%s[K' "$E" "$(( y + $1 ))" "$(( x + $2 ))" "$E"; }  # posiciona e limpa o resto
fim_cor() { printf '%s[0m' "$E"; }
repetir() { local i s=""; for (( i = 0; i < $2; i++ )); do s+="$1"; done; printf '%s' "$s"; }

entrar_tela() {
  (( tela )) || return 0
  local cols linhas
  cols=$(tput cols 2> /dev/null < /dev/tty || echo 80)
  linhas=$(tput lines 2> /dev/null < /dev/tty || echo 24)
  x=$(( (cols - LARGURA) / 2 )); (( x < 0 )) && x=0
  y=$(( (linhas - 14) / 2 )); (( y < 0 )) && y=0
  trap sair_tela EXIT
  put "${E}[?1049h${E}[?25l${E}[2J"

  local interno=$(( LARGURA - 2 )) linha
  put "$(em 1 0)$(cor 99)╭$(repetir ─ "$interno")╮"
  for linha in 2 3 4 5 6 7 8; do put "$(em "$linha" 0)│$(repetir ' ' "$interno")│"; done
  put "$(em 9 0)╰$(repetir ─ "$interno")╯"
  put "$(em 7 6)$(cor 213)✦ ${E}[2;37mrascunho solto  →  prompt claro${E}[22m $(cor 159)✦$(fim_cor)"
  put "$(linha_nova 14 2)${E}[2m${modelo} · skill refinar-prompt · ctrl+c cancela$(fim_cor)"
  logo 0
}

# Desenha o logo; o deslocamento faz o gradiente correr pelas letras.
logo() {
  local desloc=$1 l i s
  for (( l = 0; l < 3; l++ )); do
    s=""
    for (( i = 0; i < 7; i++ )); do
      (( i > 0 )) && s+=" "
      s+="$(cor "${BRILHO[(i + desloc) % ${#BRILHO[@]}]}")${LOGO[i * 3 + l]}"
    done
    put "${E}[$(( y + 3 + l ));$(( x + 11 ))H${s}$(fim_cor)"
  done
}

# Cometa que vai e volta entre "rascunho" e "prompt".
cometa() {
  local f=$1 w=24 periodo=46 p frente i d s=""
  p=$(( f % periodo )); frente=1
  (( p >= w )) && { p=$(( periodo - p )); frente=0; }
  for (( i = 0; i < w; i++ )); do
    (( frente )) && d=$(( p - i )) || d=$(( i - p ))
    if (( d == 0 )); then s+="$(cor 231)●"
    elif (( d > 0 && d < ${#RASTRO[@]} )); then s+="$(cor "${RASTRO[d]}")━"
    else s+="$(cor 237)─"
    fi
  done
  printf '%s' "$s"
}

quadro() {
  (( tela )) || return 0
  local f=$1 seg=$(( SECONDS - inicio )) frase
  local idx=$(( seg / 3 )); (( idx >= ${#FRASES[@]} )) && idx=$(( ${#FRASES[@]} - 1 ))
  frase="${FRASES[idx]}…"
  (( f % 2 == 0 )) && logo $(( f / 2 ))
  put "$(linha_nova 11 2)$(cor 213)${SPINNER[f % ${#SPINNER[@]}]}$(fim_cor)  ${frase}$(em 11 $(( LARGURA - 6 )))${E}[2m$(printf '%4ss' "$seg")$(fim_cor)"
  put "$(linha_nova 12 4)${E}[2mrascunho$(fim_cor) $(cometa "$f") ${E}[2mprompt$(fim_cor)"
}

final_ok() {
  (( tela )) || return 0
  local barra="" i
  for (( i = 0; i < 24; i++ )); do barra+="$(cor "${GRADIENTE[i * 15 / 24]}")━"; done
  logo 0
  put "$(linha_nova 11 2)$(cor 114)✔$(fim_cor)  ${E}[1mprompt refinado$(fim_cor)$(em 11 $(( LARGURA - 6 )))${E}[2m$(printf '%4ss' "$(( SECONDS - inicio ))")$(fim_cor)"
  put "$(linha_nova 12 4)${E}[2mrascunho$(fim_cor) ${barra} $(cor 114)prompt$(fim_cor)"
  put "$(linha_nova 14 2)${E}[2m$1$(fim_cor)"
  sleep 1
}

final_erro() {
  (( tela )) || return 0
  put "$(linha_nova 11 2)$(cor 203)✖$(fim_cor)  $1"
  put "$(linha_nova 12 4)${E}[2mo rascunho ficou como estava$(fim_cor)"
  put "$(linha_nova 14 2)${E}[2m${2:-}$(fim_cor)"
  sleep 2.5
}

sair_tela() { put "${E}[0m${E}[?25h${E}[?1049l"; }

# Roda o comando em segundo plano e anima até ele terminar. Devolve o status dele.
animar() {
  "$@" & local pid=$! f=0
  cancelado=0
  trap 'cancelado=1; kill "$pid" 2> /dev/null' INT
  inicio=$SECONDS
  while kill -0 "$pid" 2> /dev/null; do quadro "$f"; f=$(( f + 1 )); sleep 0.08; done
  wait "$pid"
}

palavras() { printf '%s' "$1" | wc -w | tr -d ' '; }

# ---------------------------------------------------------------- demo

if [[ "${1:-}" == --demo ]]; then
  entrar_tela
  animar sleep "${REFINAR_DEMO_SEGUNDOS:-8}"
  final_ok "23 → 31 palavras · revise e dê enter"
  exit 0
fi

# ---------------------------------------------------------------- refinar

arquivo="${1:-}"
[[ "$(basename -- "$arquivo")" == claude-prompt-*.md ]] || abrir_normal "$@"

rascunho="$(cat -- "$arquivo")"
[[ -n "${rascunho//[[:space:]]/}" ]] || abrir_normal "$@"

mkdir -p "$cache"
if [[ -f "$cache/ultimo-prompt.txt" && "$(printf '%s' "$rascunho" | aparar)" == "$(aparar < "$cache/ultimo-prompt.txt")" ]]; then
  abrir_normal "$@"
fi

# Regras da skill, sem o frontmatter e sem a seção "Entrada" (que é do modo fork).
regras="$(awk '
  /^---$/ && fm < 2 { fm++; next }
  fm < 2 { next }
  /^## Entrada/ { pula = 1; next }
  /^## / { pula = 0 }
  !pula
' "$dir_skill/SKILL.md")"
boas_praticas="$(cat "$dir_skill/referencias/boas-praticas.md" 2> /dev/null || true)"
exemplos="$(cat "$dir_skill/referencias/exemplos.md" 2> /dev/null || true)"

sistema="$regras

# Boas práticas (referencias/boas-praticas.md)

$boas_praticas

# Exemplos (referencias/exemplos.md)

$exemplos

# Modo editor

A mensagem do usuário é o rascunho a refinar. Responda em duas partes, separadas por uma linha contendo exatamente $separador.
Antes dessa linha: só o prompt refinado, em texto puro, sem bloco de código e sem título.
Depois dessa linha: O que mudei, Pontos em aberto e Sugestões, no formato da skill.
Não faça perguntas. Se o rascunho for vazio demais para refinar, devolva-o como está antes da linha."

refinar() {
  cd "$cache" && printf '%s' "$rascunho" | timeout 180 claude -p \
    --model "$modelo" --tools "" --strict-mcp-config --no-session-persistence \
    --append-system-prompt "$sistema" > "$cache/ultimo.md" 2> "$cache/erro.log"
}

entrar_tela
animar refinar
status=$?

if (( cancelado )); then
  final_erro "cancelado"
  exit 0
fi
if (( status != 0 )); then
  final_erro "não deu para refinar" "detalhes em ${cache/#$HOME/\~}/erro.log"
  exit 0
fi
if ! grep -qxF "$separador" "$cache/ultimo.md"; then
  final_erro "a resposta veio fora do formato" "detalhes em ${cache/#$HOME/\~}/ultimo.md"
  exit 0
fi

refinado="$(awk -v s="$separador" '$0 == s { exit } { print }' "$cache/ultimo.md" | aparar)"
printf '%s\n' "$refinado" > "$arquivo"
printf '%s\n' "$refinado" > "$cache/ultimo-prompt.txt"
final_ok "$(palavras "$rascunho") → $(palavras "$refinado") palavras · revise e dê enter"
